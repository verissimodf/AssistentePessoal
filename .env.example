# ==============================================================================
# 🤖 CONFIGURAÇÕES DO ASSISTENTE PESSOAL (J.A.R.V.I.S.) - EXEMPLO DE AMBIENTE
# ==============================================================================
# Renomeie este arquivo para .env e preencha as variáveis de acordo com seu uso.
# Mantenha este arquivo seguro e NUNCA o envie para repositórios públicos.

# ------------------------------------------------------------------------------
# ⚙️ CONFIGURAÇÕES NATIVAS DO CORE (NODE.JS)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=127.0.0.1
API_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 💾 ISOLAMENTO DE DADOS E ARMAZENAMENTO LOCAL (JARVIS_DATA_DIR)
# ------------------------------------------------------------------------------
# Diretório para isolamento de arquivos de runtime (SQLite, tokens, backups, vozes, documentos).
# Recomenda-se manter FORA do Google Drive ou OneDrive para prevenir travamentos de I/O (file locks).
# Exemplo Windows: JARVIS_DATA_DIR=C:\Users\Usuario\AppData\Local\JarvisData
# Exemplo Linux:   JARVIS_DATA_DIR=/var/lib/jarvis/data
JARVIS_DATA_DIR=./data

# Chave mestra hexadecimal de 32 bytes para criptografia no banco SQLite (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JARVIS_MASTER_KEY=

# ------------------------------------------------------------------------------
# 🔒 CAMADA DE SEGURANÇA E CRIPTOGRAFIA
# ------------------------------------------------------------------------------
ENCRYPTION_KEY=sua_chave_secreta_hexadecimal_aqui_de_32_bytes

# Nível de Autonomia dos Bots (1 = Apenas Alertas, 2 = Confirmação, 3 = Autônomo)
BOT_AUTONOMY_LEVEL=1
ENABLE_HOST_COMMANDS=false

# ------------------------------------------------------------------------------
# 🎙️ INTERAÇÃO, WAKE WORD E VOZ (PYTHON / EXTERNO)
# ------------------------------------------------------------------------------
# Escolha do motor de TTS/STT: 'local' (XTTS-v2/Kokoro) ou 'cloud' (ElevenLabs/OpenAI)
VOICE_ENGINE=local
WAKE_WORD=jarvis
CLAP_DETECTION_SENSITIVITY=0.6

# URL do serviço Python de síntese e clonagem local (scripts/voz/voice_service.py)
JARVIS_VOICE_URL=http://127.0.0.1:7778

# Provedores de Voz em Nuvem (Se aplicável)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ------------------------------------------------------------------------------
# 🧠 PROVEDORES DE INTELIGÊNCIA ARTIFICIAL (LLM & EMBEDDINGS)
# ------------------------------------------------------------------------------
# Defina qual provedor principal o Jarvis usará (ollama, openai, anthropic, gemini, groq)
DEFAULT_AI_PROVIDER=ollama

# Configurações Ollama (100% Offline e Local)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Credenciais de IAs em Nuvem (Preencha apenas as que for utilizar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 💬 CANAIS DE COMUNICAÇÃO (BOTS INTERATIVOS)
# ------------------------------------------------------------------------------
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# WhatsApp Cloud API (Meta Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# 📧 INTEGRAÇÕES DE E-MAIL (IMAP / SMTP REAL)
# ------------------------------------------------------------------------------
# Por padrão o Jarvis opera em modo mock seguro. Para habilitar o transporte real IMAP/SMTP:
JARVIS_MAIL_TRANSPORT=imap

# Parâmetros de conta (App Password para Gmail ou Outlook):
JARVIS_MAIL_USER=seu_email@gmail.com
JARVIS_MAIL_PASSWORD=sua_senha_de_aplicativo_aqui
JARVIS_MAIL_PROVIDER=gmail

# ------------------------------------------------------------------------------
# 📅 CALENDÁRIO
# ------------------------------------------------------------------------------
# Calendários (URL pública ou local do arquivo .ics)
CALENDAR_ICS_URL=

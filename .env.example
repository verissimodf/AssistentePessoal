# ===================================================================
#  Jarvis - exemplo de ambiente (copie para .env)
#  As chaves de API são configuradas pelo painel e guardadas cifradas
#  em data/jarvis.db. Este arquivo só ajusta o serviço local.
# ===================================================================
JARVIS_PORT=7777
# 127.0.0.1 = só este computador. Use 0.0.0.0 apenas em rede confiável.
JARVIS_HOST=127.0.0.1
# Pasta dos dados locais (banco, amostras de voz, chave mestra)
# JARVIS_DATA_DIR=./data
# Senha mestra opcional para cifrar as chaves (padrão: data/master.key gerada)
# JARVIS_MASTER_KEY=
# Origens extras permitidas a falar com o serviço (separadas por vírgula)
# JARVIS_ALLOWED_ORIGINS=http://meu-servidor:8080

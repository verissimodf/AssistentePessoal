# =============================================================================
# J.A.R.V.I.S. — TEMPLATE de TLS para jarvis.laytech.com.br
# =============================================================================
# Este arquivo NÃO é carregado automaticamente. Ele existe para o dia em que DNS,
# certificado e proxy estiverem disponíveis. Enquanto o domínio não resolver e não
# houver certificado válido, o acesso operacional continua em HTTP na LAN/tailnet.
#
# Regras:
#   - HSTS SÓ neste bloco 443 (nunca no HTTP interno).
#   - HTTP → HTTPS com 301, preservando o caminho ACME.
#   - Certificados montados em /etc/nginx/certs (Let's Encrypt ou corporativo).
#   - JARVIS_COOKIE_SECURE=1 somente depois que TODO acesso autenticado for HTTPS.
#
# Para validar a sintaxe sem ativar:
#   docker run --rm -v "$PWD/deploy:/etc/nginx/conf.d:ro" \
#     -v /caminho/dos/certs:/etc/nginx/certs:ro nginx:stable nginx -t
# =============================================================================

server {
    listen 80;
    server_name jarvis.laytech.com.br;

    # Renovação ACME sem exigir HTTPS (webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name jarvis.laytech.com.br;

    ssl_certificate     /etc/nginx/certs/jarvis.laytech.com.br.fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/jarvis.laytech.com.br.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:JARVIS_TLS:10m;
    ssl_session_timeout 1h;

    # HSTS apenas na camada HTTPS pública. `preload` fica de fora de propósito:
    # é difícil de reverter e exige auditoria própria.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    client_max_body_size 25M;

    # DNS do Docker para resolver o serviço a cada requisição.
    resolver 127.0.0.11 valid=30s ipv6=off;

    location /api/ {
        set $jarvis_api assistente-pessoal:7777;
        proxy_pass http://$jarvis_api;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        set $jarvis_panel assistente-pessoal:8090;
        proxy_pass http://$jarvis_panel;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_http_version 1.1;
        proxy_read_timeout 300s;
    }
}
